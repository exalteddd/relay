# Copy to .env for local development. .env is gitignored — never commit real values.
# In production these are set in the Render dashboard, not in any file.

# ---------------------------------------------------------------- server
# Signs the session cookie. Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
# Required whenever RELAY_ENV is not "dev".
SESSION_SECRET=

# GitHub OAuth app (Settings > Developer settings > OAuth Apps).
# Callback URL must be exactly  <your-origin>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: restrict who may start a run. Comma-separated GitHub logins.
# Leave empty to allow any signed-in GitHub user.
RELAY_ALLOWED_USERS=

# "dev" relaxes cookie security for http://localhost. Set to "prod" when deployed.
RELAY_ENV=dev

# ------------------------------------------------------------- projects
# Where each user's projects are stored.
#   set    -> PostgreSQL (Render injects this from the attached database)
#   unset  -> a local SQLite file, which is the right default for development
# On a deployed instance an unset DATABASE_URL means projects sit on an
# ephemeral disk and are wiped on the next deploy. /api/config reports which
# engine is live as "storage".
DATABASE_URL=
# Optional: path to the SQLite file used when DATABASE_URL is unset.
# RELAY_DB=relay.db

# ---------------------------------------------------- agents / model access
# The research pipeline uses these, and so does the report's "Write narrative"
# button, which drafts the abstract, discussion and limitations from the
# project graph and then fact-checks its own draft against it. Leave these
# unset and the report still exports -- it just uses its assembled prose.
# The research pipeline uses two tiers: a strong model for planning, synthesis,
# hypotheses and critique, and a fast model for the bulk screening and
# extraction passes. Defaults per provider are set in brain/config.py.

# --- OpenAI (default choice here; roughly 3-7x cheaper than Anthropic for this
# workload at ~2.5 cents per run on the models below)
BRAIN_PROVIDER=openai
OPENAI_API_KEY=
# BRAIN_MODEL=gpt-5-mini        # strong tier (default)
# BRAIN_FAST_MODEL=gpt-5-nano   # fast tier (default)
# gpt-5 models are reasoning models: minimal | low | medium | high. Reasoning
# tokens are billed as output and are spent from the same allowance as the
# answer, so effort drives both cost and the risk of a truncated reply.
# The strong tier follows the model's own default unless set here:
# BRAIN_REASONING_EFFORT=low
# The fast tier runs bulk screening and extraction, where deep reasoning mostly
# burns budget, so it defaults to "low". Raise it if claim extraction is thin.
# BRAIN_FAST_REASONING_EFFORT=low

# --- Anthropic
# BRAIN_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# BRAIN_MODEL=claude-sonnet-4-5
# BRAIN_FAST_MODEL=claude-haiku-4-5

# --- Any other OpenAI-compatible endpoint (Databricks Model Serving, a
# university gateway). The client probes which parameters the endpoint accepts.
# BRAIN_PROVIDER=openai
# OPENAI_BASE_URL=https://<workspace>.cloud.databricks.com/serving-endpoints
# DATABRICKS_TOKEN=
# BRAIN_MODEL=<your-endpoint-name>

# Literature APIs (optional, raise rate limits)
OPENALEX_EMAIL=
OPENALEX_API_KEY=
S2_API_KEY=

# Where memory + project repos live
# BRAIN_HOME=~/.second-brain
